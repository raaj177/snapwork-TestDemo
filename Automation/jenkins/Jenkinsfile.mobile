// Mobile test pipeline (Android + iOS) for the TypeScript + WebdriverIO + Appium framework.
// Generated by automation-setup from assets/jenkins/Jenkinsfile.mobile.template; extended with the device check and the
// workbook run commands (smoke / regression / integration).
//
// Jenkins job : "Pipeline script from SCM", Script Path = Automation/jenkins/Jenkinsfile.mobile
// Agent       : MUST be the machine the Android phone is attached to over USB (or where the emulator runs).
//               Android needs the Android SDK (platform-tools/adb); iOS needs a macOS agent with Xcode.
//               Linux, macOS and Windows agents work (commands go through run(): sh on Unix, bat on Windows).
// Plugins     : NodeJS, JUnit, HTML Publisher, Timestamper, Credentials Binding.
// Secrets     : never in this file. Test accounts, app values and Jira come from Jenkins credentials:
//               ENV_FILE_CREDENTIALS_ID (Secret file = a complete .env) and/or NORMAL_USER_CREDENTIALS_ID
//               (Username with password -> LOGIN_NORMAL_USERNAME / LOGIN_NORMAL_PASSWORD).
//
// Test types (TEST_SUITE):
//   smoke       - the workbook's P0 cases (src/tests/smoke/<WorkbookName>/). SMOKE_GATE=true runs the build gate
//                 (ACCEPT / REJECT / INCONCLUSIVE, run record in reports/smoke/<WorkbookName>/<BUILD_TAG>/).
//   regression  - every implemented Automation Candidate of the workbook (P0 from smoke + P1/P2 from regression),
//                 optionally only STORIES.
//   integration - src/tests/integration/ (skipped with a message while the folder has no specs).
//   all         - regression, then integration.
// TEST_ID / SPEC override TEST_SUITE: a direct run of those IDs / that spec.

def AUTOMATION_DIR = 'Automation'   // framework folder, relative to the repository root ('.' when at the root)

def run(String command) {
  if (isUnix()) { sh command } else { bat command }
}

// stdout of a command (Windows: '@' keeps cmd.exe from echoing the command into the output)
def out(String command) {
  return (isUnix() ? sh(script: command, returnStdout: true) : bat(script: "@${command}", returnStdout: true)).trim()
}

pipeline {
  agent any

  tools { nodejs 'NodeJS-24' }

  options {
    timestamps()
    timeout(time: 90, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '20'))
    disableConcurrentBuilds()   // one phone = one run at a time
  }

  parameters {
    // ---- What to run ----
    choice(name: 'TEST_SUITE', choices: ['smoke', 'regression', 'integration', 'all'], description: 'Test type: smoke = P0 cases; regression = all implemented workbook cases (P0 + P1/P2); integration = src/tests/integration; all = regression + integration')
    string(name: 'WORKBOOK', defaultValue: '', description: 'Approved workbook file name in Automation/testcase/Testcases/ (empty = the only workbook there)')
    string(name: 'STORIES', defaultValue: '', description: 'regression only: story IDs to run, space or comma separated, e.g. US002 US003 (empty = every story)')
    booleanParam(name: 'SMOKE_GATE', defaultValue: false, description: 'smoke only: run the P0 build gate (smoke:run) with an ACCEPT / REJECT / INCONCLUSIVE decision instead of a plain smoke run')
    booleanParam(name: 'SMOKE_PARTIAL', defaultValue: false, description: 'smoke gate only: run the implemented P0 cases although coverage is incomplete (always INCONCLUSIVE)')
    choice(name: 'RETRIES', choices: ['0', '1', '2'], description: 'Retries of a failed test (workbook runs)')
    string(name: 'TEST_ID', defaultValue: '', description: 'Optional testcase ID(s), comma-separated, e.g. TC_US002_025 (overrides TEST_SUITE)')
    string(name: 'SPEC', defaultValue: '', description: 'Optional spec file, e.g. src/tests/smoke/<WorkbookName>/US002.test.ts (overrides TEST_SUITE; combines with TEST_ID)')
    choice(name: 'PLATFORM', choices: ['android', 'ios'], description: 'Platform to run')

    // ---- Device ----
    string(name: 'ANDROID_HOME', defaultValue: '', description: 'Android: SDK folder that contains platform-tools/adb (empty = the agent\'s ANDROID_HOME / ANDROID_SDK_ROOT)')
    string(name: 'DEVICE_UDID', defaultValue: '', description: 'Device serial from `adb devices` (no spaces); empty = the only connected device')
    booleanParam(name: 'LAUNCH_APP', defaultValue: true, description: 'Bring the app to the foreground before the tests (the workbook runs require the app open on the phone)')

    // ---- App (empty = value from the .env file credential) ----
    string(name: 'APP_PACKAGE', defaultValue: '', description: 'Android app package')
    string(name: 'APP_ACTIVITY', defaultValue: '', description: 'Android launch activity')
    string(name: 'APP_PATH', defaultValue: '', description: 'Optional .apk/.app/.ipa to install at session start (empty = the app already installed on the phone)')
    string(name: 'BUNDLE_ID', defaultValue: '', description: 'iOS bundle ID')

    // ---- Credentials (IDs of Jenkins credentials; values never appear in the log) ----
    string(name: 'ENV_FILE_CREDENTIALS_ID', defaultValue: 'automation-env', description: 'Secret file credential holding the complete .env (app values, test accounts, Jira); copied to Automation/.env for this build and removed afterwards')
    string(name: 'NORMAL_USER_CREDENTIALS_ID', defaultValue: '', description: 'Username with password credential of the normal test account (sets LOGIN_NORMAL_USERNAME / LOGIN_NORMAL_PASSWORD)')
  }

  environment {
    CI = 'true'
    PLATFORM = "${params.PLATFORM}"
    TEST_ENV = 'qa'   // the project's only environment
    LOG_LEVEL = 'info'
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
        script {
          // Only filled-in parameters are exported: an empty variable would hide the .env / agent value.
          ['DEVICE_UDID', 'APP_PATH', 'APP_PACKAGE', 'APP_ACTIVITY', 'BUNDLE_ID'].each { name ->
            def value = params[name]?.trim()
            if (value) { env."${name}" = value }
          }
          def sdk = params.ANDROID_HOME?.trim() ? params.ANDROID_HOME.trim() : (env.ANDROID_HOME ?: env.ANDROID_SDK_ROOT ?: '')
          if (sdk) { env.ANDROID_HOME = sdk; env.ANDROID_SDK_ROOT = sdk }
        }
        dir(AUTOMATION_DIR) {
          script {
            run 'npm run clean --if-present'
            // The previous build's runs are archived with that build: start this build's report from its own runs only
            // (.allure-history/ is kept for the Trend graph).
            run "node -e \"for (const d of ['test-results/runs', 'test-results/ci-allure-results', 'reports/smoke', 'report']) require('fs').rmSync(d, { recursive: true, force: true })\""
          }
        }
      }
    }

    stage('Configuration') {
      steps {
        dir(AUTOMATION_DIR) {
          script {
            if (params.ENV_FILE_CREDENTIALS_ID?.trim()) {
              withCredentials([file(credentialsId: params.ENV_FILE_CREDENTIALS_ID.trim(), variable: 'ENV_FILE')]) {
                run(isUnix() ? 'cp "$ENV_FILE" .env' : 'copy /Y "%ENV_FILE%" .env >NUL')
              }
              echo '.env written from the Secret file credential (values are not printed).'
            } else {
              echo 'No ENV_FILE_CREDENTIALS_ID: settings come from the parameters, the agent environment and the framework defaults.'
            }
          }
        }
      }
    }

    stage('Install') {
      steps {
        dir(AUTOMATION_DIR) {
          script { run 'npm ci' }
        }
      }
    }

    stage('Type-check and lint') {
      steps {
        dir(AUTOMATION_DIR) {
          script {
            run 'npm run typecheck'
            run 'npm run lint'
          }
        }
      }
    }

    stage('Appium driver') {
      steps {
        dir(AUTOMATION_DIR) {
          script {
            // The driver is a pinned project dependency installed by npm ci; this only reports it.
            def driver = params.PLATFORM == 'ios' ? 'xcuitest' : 'uiautomator2'
            def installed = out('npx appium driver list --installed 2>&1')
            echo installed
            if (!installed.contains(driver)) { error "Appium driver ${driver} is not installed: it is a project dependency, check that npm ci succeeded." }
          }
        }
      }
    }

    stage('Device check') {
      steps {
        dir(AUTOMATION_DIR) {
          script {
            if (params.PLATFORM == 'android') {
              if (!env.ANDROID_HOME) { error 'Set the ANDROID_HOME build parameter or the agent ANDROID_HOME / ANDROID_SDK_ROOT variable.' }
              // Prints serial (masked), manufacturer + model, Android version / SDK, screen awake / locked and the installed
              // app version; fails when the device is not connected, not authorized, asleep, locked or without the app.
              run('npm run ci:device' + (params.LAUNCH_APP ? ' -- --launch-app' : ''))
            } else {
              if (!isUnix()) { error 'iOS runs need a macOS agent with Xcode.' }
              sh 'xcrun simctl list devices booted; xcrun xctrace list devices 2>/dev/null || true'
            }
          }
        }
      }
    }

    stage('Tests') {
      steps {
        dir(AUTOMATION_DIR) {
          script {
            def creds = params.NORMAL_USER_CREDENTIALS_ID?.trim()
              ? [usernamePassword(credentialsId: params.NORMAL_USER_CREDENTIALS_ID.trim(), usernameVariable: 'LOGIN_NORMAL_USERNAME', passwordVariable: 'LOGIN_NORMAL_PASSWORD')]
              : []
            withCredentials(creds) {
              // ---- Direct run of IDs / one spec (overrides TEST_SUITE) ----
              if (params.TEST_ID?.trim() || params.SPEC?.trim()) {
                env.EXECUTION_TYPE = 'regression'
                env.RUN_ID = "direct-${env.BUILD_TAG}"
                def args = []
                if (params.SPEC?.trim()) { args << "--spec \"${params.SPEC.trim()}\"" }
                if (params.TEST_ID?.trim()) {
                  // Validated IDs go to the wdio config as TEST_IDS (grep built in-process: no '|' / '^' through sh or cmd.exe).
                  def ids = params.TEST_ID.split(',').collect { it.trim() }.findAll { it }
                  def bad = ids.findAll { !(it ==~ /TC_[A-Za-z0-9_]+/) }
                  if (bad) { error "Invalid testcase ID(s) in TEST_ID: ${bad.join(', ')}" }
                  env.TEST_IDS = ids.unique().join(',')
                }
                run "npm run test:${params.PLATFORM}" + (args ? " -- ${args.join(' ')}" : '')
                return
              }

              def wb = out("node scripts/ci/workbook.mjs \"${params.WORKBOOK?.trim() ?: ''}\"")
              echo "Workbook: ${wb}"
              def stories = (params.STORIES ?: '').split(/[\s,]+/).collect { it.trim().toUpperCase() }.findAll { it }
              def badStories = stories.findAll { !(it ==~ /US\d+/) }
              if (badStories) { error "Invalid story ID(s) in STORIES: ${badStories.join(', ')} (use US002 US003)" }
              def suites = params.TEST_SUITE == 'all' ? ['regression', 'integration'] : [params.TEST_SUITE]

              suites.each { suite ->
                stage("${suite}") {
                  // A failure is recorded and the next suite of TEST_SUITE=all still runs.
                  catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                    if (suite == 'integration') {
                      if (out('node scripts/ci/count-specs.mjs integration') == '0') {
                        echo 'No integration specs in src/tests/integration/ yet: nothing to run.'
                        return
                      }
                      env.EXECUTION_TYPE = 'regression'
                      env.RUN_ID = "integration-${env.BUILD_TAG}"
                      run "npm run test:${params.PLATFORM} -- --spec \"src/tests/integration/**/*.test.ts\""
                    } else if (params.PLATFORM == 'ios') {
                      // The workbook commands have no iOS preflight yet: run the folder directly.
                      env.EXECUTION_TYPE = suite
                      env.RUN_ID = "${suite}-${env.BUILD_TAG}"
                      run "npm run test:ios -- --spec \"src/tests/${suite}/**/*.test.ts\""
                    } else if (suite == 'smoke' && params.SMOKE_GATE) {
                      // P0 build gate: coverage check, P0 run, decision + run record (reports/smoke/<WorkbookName>/<BUILD_TAG>/).
                      def gate = "--workbook \"${wb}\" --platform ${params.PLATFORM} --build-id \"${env.BUILD_TAG}\""
                      if (params.SMOKE_PARTIAL) { gate += ' --partial' }
                      run "npm run smoke:run -- ${gate}"
                    } else {
                      // Workbook run: preflight (device, app installed and open, ports), selection by ID + title,
                      // a per-run report in report/runs/<RUN_ID>/ (+ ZIP). Exit 1 = test failures, 3 = device not ready.
                      def cmd = "npm run ${suite} -- \"${wb}\""
                      if (suite == 'regression' && stories) { cmd += ' ' + stories.join(' ') }
                      cmd += " --retries ${params.RETRIES}"
                      run cmd
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  post {
    always {
      // JUnit: direct runs write test-results/junit/, workbook runs test-results/runs/<RUN_ID>/junit/.
      junit allowEmptyResults: true, testResults: "${AUTOMATION_DIR}/test-results/**/junit/*.xml"
      dir(AUTOMATION_DIR) {
        script {
          // ONE Allure report of every run in this build (smoke / regression / integration / direct): Overview with
          // Environment (device, app version, workbook), Categories, Executor and Trend; Behaviors epic > feature > story;
          // each test with its steps, step screenshots, failure screenshot, page source and log; Logger + Screenshots tabs.
          try { run 'npm run report:ci' } catch (ignored) { echo 'Allure report not generated (no Allure results in this build).' }
          // Never leave the secret .env on the agent.
          if (params.ENV_FILE_CREDENTIALS_ID?.trim()) { run(isUnix() ? 'rm -f .env' : 'if exist .env del /F /Q .env') }
        }
      }
      publishHTML(target: [
        reportName: 'Run Reports',
        reportDir: "${AUTOMATION_DIR}/report",
        // report/index.html: dashboard of the smoke / regression runs of this build, each with its Allure report.
        reportFiles: 'index.html',
        keepAll: true,
        alwaysLinkToLastBuild: true,
        allowMissing: true
      ])
      publishHTML(target: [
        reportName: 'Mobile Allure Report',
        reportDir: "${AUTOMATION_DIR}/allure-report",
        // allure-report/logger/ and allure-report/Screenshots/ are added by npm run report (scripts/allure-extras.mjs).
        reportFiles: 'index.html, logger/index.html, Screenshots/index.html',
        reportTitles: 'Allure, Logger, Screenshots',
        keepAll: true,
        alwaysLinkToLastBuild: true,
        allowMissing: true
      ])
      archiveArtifacts artifacts: "${AUTOMATION_DIR}/report/**, ${AUTOMATION_DIR}/test-results/**, ${AUTOMATION_DIR}/reports/smoke/**, ${AUTOMATION_DIR}/screenshots/**, ${AUTOMATION_DIR}/logs/**",
        excludes: "${AUTOMATION_DIR}/.env",
        allowEmptyArchive: true
    }
  }
}
