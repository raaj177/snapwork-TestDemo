# Copy to .env (Git-ignored) and fill in. Never commit secrets.
PLATFORM=android
TEST_ENV=qa
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723
DEVICE_UDID=
DEVICE_NAME=
PLATFORM_VERSION=
# Android app (read from the app build with aapt dump badging)
APP_PACKAGE=
APP_ACTIVITY=
START_ACTIVITY=
# iOS app (CFBundleIdentifier from Info.plist)
BUNDLE_ID=
# Optional: .apk/.ipa/.app installed at session start (empty = app already installed)
APP_PATH=
# Speed: reuse the screen the previous test left (clean login screen, returning-user screen, live Dashboard session)
# instead of relaunching before every test; unknown or dirty state still relaunches. false = strict relaunch per test.
REUSE_APP_STATE=true
# Pause after an app (re)start before the first lookup (ms). Lower it if your build starts fast (release builds).
APP_START_SETTLE_MS=5000
NO_RESET=true
NEW_COMMAND_TIMEOUT=240
UIAUTOMATOR2_SYSTEM_PORT=8200
WDA_LOCAL_PORT=8100
MAX_INSTANCES=1
MOCHA_TIMEOUT=300000
MOCHA_RETRIES=2
# Attempts of a launch step (app start + first screen check) when the UiAutomator2 server freezes.
STEP_MAX_ATTEMPTS=2
AUTOMATION_RESULTS_FILE=test-results/automation-results/automation-results.csv
ALLURE_RESULTS_DIR=allure-results
JUNIT_DIR=test-results/junit
LOG_DIR=logs
LOG_LEVEL=info
STEP_SCREENSHOTS=true
WDIO_LOG_LEVEL=warn
# Secrets for test users are named in src/data/test-data.json (passwordEnv) and set here, e.g.
# TEST_USER_PASSWORD=

# Test accounts (fill in .env only)
LOGIN_NORMAL_USERNAME=
LOGIN_NORMAL_PASSWORD=
LOGIN_2FA_USERNAME=
LOGIN_2FA_PASSWORD=

# Jira (smoke-bugs-to-jira; fill in .env only)
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
