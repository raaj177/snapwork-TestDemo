# Automation framework. Committed: source, config, tests, docs, Jenkins/CI files, testcase workbooks (inputs),
# handoffs, locator evidence (redacted), Jira records. Never committed: dependencies, app builds, run output, secrets.

# ---- Dependencies ----
node_modules/

# ---- Run output (generated by every run) ----
# Anchored to the framework root (leading /): a bare "report/" would also hide scripts/report/ (source code).
/test-results/
/allure-results/
/allure-report/
/playwright-report/
/blob-report/
/logs/
/screenshots/
/report/
/reports/
/.allure-history/

# ---- Run results written into the testcase folder (keep the folders, not the files) ----
testcase/Output Testcases/*
!testcase/Output Testcases/.gitkeep
testcase/CSV Files/*
!testcase/CSV Files/.gitkeep

# ---- Suites generated by the run scripts per workbook (rebuilt on every run) ----
suites/*/
!suites/templates/

# ---- Local configuration and private data ----
.env
.env.*
!.env.example
test-data.local.json

# ---- App binaries (local only; keep the folders) ----
apps/**
!apps/android/
!apps/ios/
!apps/**/.gitkeep
*.apk
*.aab
*.ipa

# ---- Workbook / Office lock files ----
~$*

# ---- Temporary device dumps ----
*.uix
window_dump.xml

# ---- Python (scripts/testrun) ----
__pycache__/
*.py[cod]

# ---- IDE / OS ----
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
