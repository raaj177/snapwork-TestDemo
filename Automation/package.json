{
    "name": "universal-kits-automation",
    "version": "1.0.0",
    "private": true,
    "description": "Mobile automation framework (TypeScript + WebdriverIO + Appium + Mocha + Allure) for Android and iOS",
    "type": "module",
    "engines": {
        "node": ">=24.22.1"
    },
    "scripts": {
        "typecheck": "tsc --noEmit",
        "lint": "eslint config src scripts wdio.conf.ts",
        "lint:fix": "eslint config src scripts wdio.conf.ts --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test:android": "wdio run config/wdio.android.conf.ts",
        "test:ios": "wdio run config/wdio.ios.conf.ts",
        "test:regression": "node scripts/report/run-regression.mjs",
        "smoke": "node scripts/run/cli.mjs smoke",
        "regression": "node scripts/run/cli.mjs regression",
        "run-commands:test": "node --test scripts/run/__tests__/*.test.mjs",
        "smoke:generate": "tsx scripts/smoke/generate.ts",
        "smoke:check": "tsx scripts/smoke/check.ts",
        "smoke:run": "tsx scripts/smoke/run.ts",
        "smoke:record": "tsx scripts/smoke/record.ts",
        "smoke:test": "node --import tsx --test scripts/smoke/__tests__/*.test.ts",
        "test-data:test": "node --import tsx --test src/services/__tests__/*.test.ts",
        "report": "allure generate allure-results --clean -o allure-report && node scripts/allure-extras.mjs",
        "report:share": "node scripts/report/build-share-report.mjs",
        "report:share:test": "node --test scripts/report/__tests__/*.test.mjs",
        "clean": "node scripts/clean.mjs",
        "ci:device": "node scripts/ci/device-info.mjs"
    },
    "devDependencies": {
        "@faker-js/faker": "10.6.0",
        "@types/mocha": "10.0.10",
        "@types/node": "24.19.2",
        "@wdio/allure-reporter": "10.2.0",
        "@wdio/appium-service": "10.2.0",
        "@wdio/cli": "10.2.0",
        "@wdio/globals": "10.2.0",
        "@wdio/junit-reporter": "10.2.0",
        "@wdio/local-runner": "10.2.0",
        "@wdio/mocha-framework": "10.2.0",
        "@wdio/spec-reporter": "10.2.0",
        "@wdio/types": "10.2.0",
        "allure-commandline": "2.46.1",
        "appium": "4.0.0",
        "appium-uiautomator2-driver": "10.0.0",
        "appium-xcuitest-driver": "13.6.1",
        "axios": "1.21.1",
        "dotenv": "18.0.10",
        "eslint": "10.15.0",
        "exceljs": "4.4.0",
        "expect-webdriverio": "8.1.0",
        "prettier": "3.10.1",
        "tsx": "4.23.15",
        "typescript": "6.0.3",
        "typescript-eslint": "8.73.0",
        "webdriverio": "10.2.0",
        "winston": "3.19.0",
        "zod": "4.6.7"
    }
}
