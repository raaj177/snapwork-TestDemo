// Web test pipeline for a Playwright Test (TypeScript) framework.
// Generated by automation-setup from assets/jenkins/Jenkinsfile.web.template.
//
// Jenkins job: "Pipeline script from SCM", Script Path = {{JENKINSFILE_PATH}}
// The web framework's playwright.config.ts is expected to define the projects chromium / firefox / webkit and
// the reporters: ['junit', { outputFile: 'test-results/junit.xml' }], ['html'] and allure-playwright.
// Tests are tagged in their titles (@smoke, @sanity, @regression, @cross-browser) and start with their testcase ID.
// Works on Linux, macOS and Windows agents (commands go through run(): sh on Unix, bat on Windows).
// Secrets (test users) come from Jenkins credentials as environment variables, never from this file.

def WEB_AUTOMATION_DIR = '{{WEB_AUTOMATION_DIR}}'   // web framework folder, relative to the repository root ('.' when at the root)

def run(String command) {
  if (isUnix()) { sh command } else { bat command }
}

pipeline {
  agent any

  tools { nodejs '{{JENKINS_NODEJS_TOOL}}' }

  options {
    timestamps()
    timeout(time: 30, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '20'))
    disableConcurrentBuilds()
  }

  parameters {
    choice(name: 'TEST_SUITE', choices: ['all', 'sanity', 'smoke', 'regression'], description: 'Tag to run; smoke = the P0 build gate (npm run smoke:run)')
    string(name: 'SMOKE_WORKBOOK', defaultValue: '', description: 'TEST_SUITE=smoke only: approved workbook file name in testcase/Testcases/')
    booleanParam(name: 'SMOKE_PARTIAL', defaultValue: false, description: 'TEST_SUITE=smoke only: run the implemented P0 cases although coverage is incomplete (always INCONCLUSIVE)')
    string(name: 'TEST_ID', defaultValue: '', description: 'Optional testcase ID(s) such as TC_US001_001, comma-separated (overrides TEST_SUITE)')
    choice(name: 'TEST_ENV', choices: ['qa', 'uat', 'staging'], description: 'Target environment')
    string(name: 'BASE_URL', defaultValue: '', description: 'Optional URL override (empty = the URL configured for TEST_ENV)')
    booleanParam(name: 'HEADLESS', defaultValue: true, description: 'Run the browser without a visible window')
    booleanParam(name: 'ALL_BROWSERS', defaultValue: false, description: 'Also run the @cross-browser tests on Firefox and WebKit')
  }

  environment {
    CI = 'true'
    HEADLESS = "${params.HEADLESS}"
    TEST_ENV = "${params.TEST_ENV}"
    LOG_LEVEL = 'info'
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
        dir(WEB_AUTOMATION_DIR) {
          script {
            if (isUnix()) {
              sh 'rm -rf allure-results allure-report playwright-report test-results'
            } else {
              bat 'for %%d in (allure-results allure-report playwright-report test-results) do if exist %%d rmdir /s /q %%d'
            }
            if (params.BASE_URL?.trim()) { env.BASE_URL = params.BASE_URL.trim() }
          }
        }
      }
    }

    stage('Install') {
      steps {
        dir(WEB_AUTOMATION_DIR) {
          run 'npm ci'
        }
      }
    }

    stage('Type-check and lint') {
      steps {
        dir(WEB_AUTOMATION_DIR) {
          run 'npm run typecheck --if-present'
          run 'npm run lint --if-present'
        }
      }
    }

    stage('Browsers') {
      steps {
        dir(WEB_AUTOMATION_DIR) {
          script {
            run(params.ALL_BROWSERS ? 'npx playwright install chromium firefox webkit' : 'npx playwright install chromium')
          }
        }
      }
    }

    stage('Web tests') {
      steps {
        dir(WEB_AUTOMATION_DIR) {
          script {
            if (params.TEST_SUITE == 'smoke' && !params.TEST_ID?.trim()) {
              // P0 build gate: coverage check, the workbook's P0 cases only, ACCEPT/REJECT/INCONCLUSIVE and a run record
              // under reports/smoke/<WorkbookName>/<BUILD_TAG>/ (implement-testcases-v2/references/p0-smoke.md).
              if (!params.SMOKE_WORKBOOK?.trim()) { error 'TEST_SUITE=smoke needs SMOKE_WORKBOOK (the approved workbook file name).' }
              def smokeArgs = "--workbook \"${params.SMOKE_WORKBOOK.trim()}\" --platform web --build-id \"${env.BUILD_TAG}\""
              if (params.SMOKE_PARTIAL) { smokeArgs += ' --partial' }
              run "npm run smoke:run -- ${smokeArgs}"
              return
            }
            env.EXECUTION_TYPE = 'regression'  // Allure label for npm run report:share; smoke:run sets smoke itself
            env.RUN_ID = "regression-${env.BUILD_TAG}"
            def args = []
            if (!params.ALL_BROWSERS) { args << '--project=chromium' }
            if (params.TEST_ID?.trim()) {
              // Validate, then hand the IDs to playwright.config.ts as TEST_IDS: it sets grep in-process to
              // (?:^|\s)(?:ID1|ID2):  (Playwright also matches the full title: describe names, then the test title).
              def ids = params.TEST_ID.split(',').collect { it.trim() }.findAll { it }
              def bad = ids.findAll { !(it ==~ /TC_[A-Za-z0-9_]+/) }
              if (bad) { error "Invalid testcase ID(s) in TEST_ID: ${bad.join(', ')}" }
              env.TEST_IDS = ids.unique().join(',')
            } else if (params.TEST_SUITE != 'all') {
              args << "--grep \"@${params.TEST_SUITE}\""
            }
            run "npx playwright test ${args.join(' ')}"
          }
        }
      }
    }
  }

  post {
    always {
      junit allowEmptyResults: true, testResults: "${WEB_AUTOMATION_DIR}/test-results/junit.xml"
      dir(WEB_AUTOMATION_DIR) {
        script {
          try { run 'npm run report --if-present' } catch (ignored) { echo 'Allure report could not be generated (no results?).' }
        }
      }
      publishHTML(target: [
        reportName: 'Playwright Report',
        reportDir: "${WEB_AUTOMATION_DIR}/playwright-report",
        reportFiles: 'index.html',
        keepAll: true,
        alwaysLinkToLastBuild: true,
        allowMissing: true
      ])
      publishHTML(target: [
        reportName: 'Web Allure Report',
        reportDir: "${WEB_AUTOMATION_DIR}/allure-report",
        reportFiles: 'index.html',
        keepAll: true,
        alwaysLinkToLastBuild: true,
        allowMissing: true
      ])
      archiveArtifacts artifacts: "${WEB_AUTOMATION_DIR}/test-results/**, ${WEB_AUTOMATION_DIR}/playwright-report/**, ${WEB_AUTOMATION_DIR}/reports/smoke/**",
        allowEmptyArchive: true
    }
  }
}
